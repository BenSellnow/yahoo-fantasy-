# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud -> your app -> Settings -> Secrets.

# Anyone with the app link must enter this before seeing league data.
app_password = "pick-something-long"

[yahoo]
client_id = "dj0yJmk9..."          # from developer.yahoo.com/apps
client_secret = "abc123..."
redirect_uri = "https://your-app-name.streamlit.app"   # must match your Yahoo app
# Filled in after you click "Connect Yahoo" in the app once:
# refresh_token = "..."
# Optional default league:
# league_key = "461.l.123456"
